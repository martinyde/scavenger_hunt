{% extends 'base.html.twig' %}

{% block title %}Task - {{ task.title }}{% endblock %}

{% block body %}
    <div class="race-shell">
        <main class="max-w-5xl mx-auto px-6 py-10">
            <h1 class="race-title text-5xl leading-tight">{{ task.title }}</h1>
            {% if task.textBefore %}
                <div class="race-card mt-6 p-6">
                    <p class="text-base leading-relaxed">{{ task.textBefore }}</p>
                </div>
            {% endif %}
        </main>
    </div>
{% endblock %}
