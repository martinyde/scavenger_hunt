COMPOSE_PROJECT_NAME=scavenger-race
COMPOSE_DOMAIN=scavenger.local.itkdev.dk
ADMIN_COMPOSE_PROJECT_NAME=scavenger

APP_ENV=dev
APP_DEBUG=true
APP_SECRET=change-me-race-frontend-secret

# Points to admin-nginx inside the admin's docker network
ADMIN_API_URL=http://scavenger-nginx-1:8080
ADMIN_API_KEY=change-me-to-a-secure-random-string

# Mercure hub (browser-facing URL)
MERCURE_PUBLIC_URL=https://mercure-scavenger.local.itkdev.dk/.well-known/mercure
MERCURE_JWT_SECRET=change-me-to-a-secure-random-string
MERCURE_SERVICE=scavenger-mercure-1:3000

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

DEFAULT_URI=https://race-scavenger.local.itkdev.dk
