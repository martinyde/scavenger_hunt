{
    "name": "martinyde/scavenger_hunt",
    "description": "A scavenger hunt application",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "doctrine/dbal": "^3.10.1",
        "doctrine/doctrine-bundle": "^2.15.1",
        "doctrine/doctrine-migrations-bundle": "^3.4.2",
        "doctrine/orm": "^3.5.2",
        "endroid/qr-code-bundle": "^6.0",
        "phpdocumentor/reflection-docblock": "^5.6.3",
        "phpstan/phpdoc-parser": "^2.2",
        "symfony/amqp-messenger": "~7.3.0",
        "symfony/asset": "~7.3.0",
        "symfony/console": "~7.3.0",
        "symfony/doctrine-messenger": "~7.3.0",
        "symfony/dotenv": "~7.3.0",
        "symfony/expression-language": "~7.3.0",
        "symfony/flex": "^2.8.2",
        "symfony/form": "~7.3.0",
        "symfony/framework-bundle": "~7.3.0",
        "symfony/http-client": "~7.3.0",
        "symfony/intl": "~7.3.0",
        "symfony/mailer": "~7.3.0",
        "symfony/mercure-bundle": "^0.3.9",
        "symfony/messenger": "~7.3.0",
        "symfony/mime": "~7.3.0",
        "symfony/monolog-bundle": "^3.10",
        "symfony/notifier": "~7.3.0",
        "symfony/process": "~7.3.0",
        "symfony/property-access": "~7.3.0",
        "symfony/property-info": "~7.3.0",
        "symfony/runtime": "~7.3.0",
        "symfony/scheduler": "~7.3.0",
        "symfony/security-bundle": "~7.3.0",
        "symfony/serializer": "~7.3.0",
        "symfony/stimulus-bundle": "^2.29.2",
        "symfony/stopwatch": "~7.3.0",
        "symfony/string": "~7.3.0",
        "symfony/translation": "~7.3.0",
        "symfony/twig-bundle": "~7.3.0",
        "symfony/uid": "~7.3.0",
        "symfony/ux-turbo": "^2.29.2",
        "symfony/validator": "~7.3.0",
        "symfony/web-link": "~7.3.0",
        "symfony/webpack-encore-bundle": "^2.3",
        "symfony/yaml": "~7.3.0",
        "symfonycasts/reset-password-bundle": "^1.23.1",
        "symfonycasts/verify-email-bundle": "^1.17.3",
        "twig/extra-bundle": "^2.12 || ^3.21",
        "twig/twig": "^2.12 || ^3.21.1",
        "xmeltrut/word-search": "dev-master"
    },
    "require-dev": {
        "doctrine/doctrine-fixtures-bundle": "^4.1",
        "ergebnis/composer-normalize": "^2.47",
        "friendsofphp/php-cs-fixer": "^3.86",
        "phpstan/extension-installer": "^1.4",
        "phpunit/phpunit": "^12.3.6",
        "rector/rector": "^2.1",
        "symfony/browser-kit": "~7.3.0",
        "symfony/css-selector": "~7.3.0",
        "symfony/debug-bundle": "~7.3.0",
        "symfony/maker-bundle": "^1.64",
        "symfony/web-profiler-bundle": "~7.3.0",
        "vincentlanglet/twig-cs-fixer": "^3.9"
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/xmeltrut/WordSearch.git"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "endroid/installer": true,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.3.*"
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
