COMPOSE_PROJECT_NAME=scavenger-api
COMPOSE_DOMAIN=scavenger.local.itkdev.dk
ADMIN_COMPOSE_PROJECT_NAME=scavenger

APP_ENV=dev
APP_DEBUG=true
APP_SECRET=change-me-public-api-secret

# Points to admin-nginx inside the admin's docker network
ADMIN_API_URL=http://scavenger-nginx-1:8080
ADMIN_API_KEY=change-me-to-a-secure-random-string

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

DEFAULT_URI=https://api-scavenger.local.itkdev.dk
