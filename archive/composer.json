{
    "name": "scavenger/archive",
    "description": "Archive site for the Scavenger Hunt application",
    "license": "proprietary",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "scavenger/shared": "@dev",
        "symfony/asset": "~7.3.0",
        "symfony/console": "~7.3.0",
        "symfony/dotenv": "~7.3.0",
        "symfony/flex": "^2.8.2",
        "symfony/framework-bundle": "~7.3.0",
        "symfony/http-client": "~7.3.0",
        "symfony/monolog-bundle": "^3.10",
        "symfony/runtime": "~7.3.0",
        "symfony/serializer": "~7.3.0",
        "symfony/string": "~7.3.0",
        "symfony/twig-bundle": "~7.3.0",
        "symfony/yaml": "~7.3.0",
        "twig/extra-bundle": "^2.12 || ^3.21",
        "twig/twig": "^2.12 || ^3.21.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "/shared"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.3.*"
        }
    },
    "scripts": {
        "post-install-cmd": ["@auto-scripts"],
        "post-update-cmd": ["@auto-scripts"],
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        }
    }
}
