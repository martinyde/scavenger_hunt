{% extends 'base.html.twig' %}

{% block title %}Find your next hunt — Hunt Archive{% endblock %}

{% block body %}
    {# Hero / search ----------------------------------------------- #}
    <section class="border-b border-neutral-200 bg-gradient-to-b from-brand-50/60 to-neutral-50">
        <div class="max-w-7xl mx-auto px-6 py-12">
            <h1 class="text-4xl font-display tracking-tight">Find your next hunt.</h1>
            <p class="text-neutral-600 mt-2 max-w-xl">Browse community-built scavenger hunts. Start a free race in two clicks.</p>
            <form method="get" action="{{ path('app_hunts') }}" class="mt-6 flex gap-2 max-w-xl">
                <input class="input" name="q" placeholder="Search by name, city, theme…">
                <button type="submit" class="btn-primary">Search</button>
            </form>

            <div class="mt-6 flex flex-wrap items-center gap-2">
                <span class="text-xs uppercase tracking-wider text-neutral-500 mr-2">Filter</span>
                <button class="pill bg-brand-100 text-brand-800 ring-brand-300">All</button>
                <button class="pill-neutral hover:bg-neutral-200">Outdoor</button>
                <button class="pill-neutral hover:bg-neutral-200">Indoor</button>
                <button class="pill-neutral hover:bg-neutral-200">Family</button>
                <button class="pill-neutral hover:bg-neutral-200">Team building</button>
                <button class="pill-neutral hover:bg-neutral-200">History</button>
                <button class="pill-neutral hover:bg-neutral-200">Mystery</button>
            </div>
        </div>
    </section>

    {# Grid -------------------------------------------------------- #}
    <section class="max-w-7xl mx-auto px-6 py-10">
        <div class="flex items-center justify-between mb-5">
            <h2 class="text-2xl">Recently published</h2>
            <span class="text-sm text-neutral-500">{{ hunts|default([])|length }} hunts</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
            {% for hunt in hunts|default([]) %}
                <a href="{{ path('app_hunt_show', {id: hunt.id}) }}" class="card hover:shadow-pop transition-shadow no-underline text-neutral-800">
                    <div class="h-40 bg-gradient-to-br from-brand-300 to-brand-600 relative">
                        <span class="absolute top-2 left-2 pill-success">Free</span>
                        <span class="absolute top-2 right-2 pill-neutral bg-white/90">Hunt</span>
                    </div>
                    <div class="card-body">
                        <h3 class="text-base font-semibold leading-snug">{{ hunt.name }}</h3>
                        <p class="text-sm text-neutral-600 mt-1 line-clamp-2">A scavenger hunt with {{ hunt.tasks|length }} tasks.</p>
                        <div class="mt-3 flex items-center justify-between text-xs text-neutral-500">
                            <span>{{ hunt.tasks|length }} tasks</span>
                            <span>{{ hunt.races|length }} races</span>
                        </div>
                    </div>
                </a>
            {% else %}
                <div class="col-span-full">
                    <div class="card">
                        <div class="card-body text-center text-neutral-600">
                            <p>No scavenger hunts published yet.</p>
                            <a href="{{ path('app_hunts') }}" class="btn-primary btn-sm mt-3 inline-flex">Browse anyway</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </section>
{% endblock %}
