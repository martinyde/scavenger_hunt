<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Hunt Archive — Scavenger Hunt{% endblock %}</title>
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,700&display=swap">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body class="bg-neutral-50">
        <header class="bg-white border-b border-neutral-200">
            <div class="max-w-7xl mx-auto px-6 h-14 flex items-center justify-between">
                <a href="{{ path('app_home') }}" class="flex items-center gap-3 no-underline">
                    <span class="inline-block w-7 h-7 rounded-md bg-brand-600"></span>
                    <span class="font-display text-lg text-neutral-900">Hunt Archive</span>
                </a>
                <nav class="flex items-center gap-1">
                    <a class="{{ app.request.attributes.get('_route') == 'app_hunts' ? 'nav-link-active' : 'nav-link' }}" href="{{ path('app_hunts') }}">Browse</a>
                    <a class="nav-link" href="#">My races</a>
                    <a class="nav-link" href="#">About</a>
                </nav>
                <div class="flex items-center gap-2">
                    {% block page_actions %}
                        <a class="btn-secondary btn-sm" href="#">Sign in</a>
                        <a class="btn-primary btn-sm" href="{{ path('app_hunts') }}">Create a race</a>
                    {% endblock %}
                </div>
            </div>
        </header>

        {% block body %}{% endblock %}
    </body>
</html>
