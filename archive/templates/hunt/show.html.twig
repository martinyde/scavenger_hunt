{% extends 'base.html.twig' %}

{% block title %}{{ hunt.name }}{% endblock %}

{% block body %}
  <h1>{{ hunt.name }}</h1>

  <h3>Tasks ({{ hunt.tasks|length }})</h3>
  <ul>
    {% for task in hunt.tasks %}
      <li>{{ task.title }}</li>
    {% endfor %}
  </ul>

  <h3>Races</h3>
  <table class="table">
    <thead>
    <tr>
      <th>ID</th>
      <th>Type</th>
      <th>Active</th>
    </tr>
    </thead>
    <tbody>
    {% for race in hunt.races %}
      <tr>
        <td>{{ race.id }}</td>
        <td>{{ race.type }}</td>
        <td>{{ race.active ? 'Yes' : 'No' }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <a href="{{ path('app_race_create', {huntId: hunt.id}) }}" class="btn btn-success">Create New Race</a>
  <a href="{{ path('app_hunts') }}" class="btn btn-secondary">Back to list</a>
{% endblock %}
