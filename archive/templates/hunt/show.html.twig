{% extends 'base.html.twig' %}

{% block title %}{{ hunt.name }} — Hunt Archive{% endblock %}

{% block body %}
    <section class="max-w-7xl mx-auto px-6 py-10">
        <div class="flex items-start justify-between mb-6 gap-4">
            <div>
                <h1 class="text-3xl">{{ hunt.name }}</h1>
                <p class="text-neutral-600 mt-1">{{ hunt.tasks|length }} tasks · {{ hunt.races|length }} races</p>
            </div>
            <div class="flex items-center gap-2">
                <a href="{{ path('app_hunts') }}" class="btn-secondary btn-sm">Back to list</a>
                <a href="{{ path('app_race_create', {huntId: hunt.id}) }}" class="btn-primary btn-sm">Create race</a>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
            <div class="card">
                <div class="card-header">
                    <h3 class="text-xl">Tasks ({{ hunt.tasks|length }})</h3>
                </div>
                <div class="card-body">
                    <ul class="space-y-2">
                        {% for task in hunt.tasks %}
                            <li class="flex items-start gap-2">
                                <span class="pill-neutral mt-0.5">{{ loop.index }}</span>
                                <span>{{ task.title }}</span>
                            </li>
                        {% else %}
                            <li class="text-neutral-500">No tasks yet.</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3 class="text-xl">Races</h3>
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Type</th>
                            <th>Active</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for race in hunt.races %}
                            <tr>
                                <td>{{ race.id }}</td>
                                <td>{{ race.type }}</td>
                                <td>
                                    {% if race.active %}
                                        <span class="pill-success">Active</span>
                                    {% else %}
                                        <span class="pill-neutral">Inactive</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr><td colspan="3" class="text-center text-neutral-500">No races yet.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </section>
{% endblock %}
