{% extends 'base.html.twig' %}

{% block title %}Available Scavenger Hunts — Hunt Archive{% endblock %}

{% block body %}
    <section class="max-w-7xl mx-auto px-6 py-10">
        <div class="flex items-center justify-between mb-5">
            <h1 class="text-3xl">Available scavenger hunts</h1>
            <span class="text-sm text-neutral-500">{{ hunts|length }} hunts</span>
        </div>

        <div class="card">
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Tasks</th>
                        <th>Races</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for hunt in hunts %}
                        <tr>
                            <td class="font-medium">{{ hunt.name }}</td>
                            <td>{{ hunt.tasks|length }}</td>
                            <td>{{ hunt.races|length }}</td>
                            <td class="text-right">
                                <a href="{{ path('app_hunt_show', {id: hunt.id}) }}" class="btn-secondary btn-sm">View</a>
                                <a href="{{ path('app_race_create', {huntId: hunt.id}) }}" class="btn-primary btn-sm">Create race</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-center text-neutral-500">No scavenger hunts available.</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
