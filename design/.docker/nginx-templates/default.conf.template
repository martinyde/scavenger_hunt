server {
    listen ${NGINX_PORT};
    server_name localhost;

    root ${NGINX_WEB_ROOT};

    client_max_body_size ${NGINX_MAX_BODY_SIZE};

    # Trust forwarded headers from the Traefik / reverse-proxy layer.
    set_real_ip_from 172.16.0.0/16;
    real_ip_recursive on;
    real_ip_header X-Forwarded-For;

    # Static design playground — no PHP, no dynamic backend.
    # Try the literal file first, then the file with .html appended (so
    # /race-display/active resolves to /race-display/active.html), then
    # a directory's index.html (so / resolves to /index.html), else 404.
    location / {
        try_files $uri $uri.html $uri/index.html =404;
    }

    # Send log message to files symlinked to stdout/stderr.
    error_log /dev/stderr;
    access_log /dev/stdout main;
}
