{% extends 'base.html.twig' %}

{% block title %}Task{% endblock %}

{% block body %}
    <h1>Task</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ task.id }}</td>
            </tr>
            <tr>
                <th>PassKey</th>
                <td>{{ task.passKey }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ task.title }}</td>
            </tr>
            <tr>
                <th>Text_before</th>
                <td>{{ task.textBefore }}</td>
            </tr>
            <tr>
                <th>Text_after</th>
                <td>{{ task.textAfter }}</td>
            </tr>
            <tr>
              <th>Solutions</th>
              <td>{{ task.solutions|join(', ') }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_task_index') }}">back to list</a>

    <a href="{{ path('app_task_edit', {id: task.id}) }}">edit</a>

    {{ include('task/_delete_form.html.twig') }}
{% endblock %}
