{% extends 'base.html.twig' %}

{% block title %}Highscore{% endblock %}

{% block body %}
    <h1>Highscore</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ highscore.id }}</td>
            </tr>
            <tr>
                <th>Progress_task_entry</th>
                <td>{{ highscore.progressTaskEntry }}</td>
            </tr>
            <tr>
                <th>Progress_task_solution</th>
                <td>{{ highscore.progressTaskSolution }}</td>
            </tr>
            <tr>
                <th>Time</th>
                <td>{{ highscore.time }}</td>
            </tr>
            <tr>
                <th>Created</th>
                <td>{{ highscore.created ? highscore.created|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Participant_name</th>
                <td>{{ highscore.participantName }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_highscore_index') }}">back to list</a>

    <a href="{{ path('app_highscore_edit', {id: highscore.id}) }}">edit</a>

    {{ include('highscore/_delete_form.html.twig') }}
{% endblock %}
