{% extends 'base.html.twig' %}

{% block title %}Race index{% endblock %}

{% block body %}
    <h1>Race index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Scavenger hunt name</th>
                <th>Race duration</th>
                <th>State</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for race in races %}
            <tr>
                <td>{{ race.id }}</td>
                <td>{{ race.scavengerHunt.getName }}</td>
                <td>{{ race.raceDuration }}</td>
                <td>{{ race.isActive ? 'Active' : 'Inactive' }}</td>
                <td>
                    <a href="{{ path('app_race_show', {id: race.id, uuid: race.uuid}) }}">show</a>
                    <a href="{{ path('app_race_edit', {id: race.id}) }}">edit</a>
                    <a href="{{ race_frontend_base_url }}/race/{{ race.id }}/progress" target="_blank" rel="noopener">progress</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
