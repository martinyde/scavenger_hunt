{# Display when race is in progress. #}
<div>
  <div id="try-form">
    <table class="table">
      <tbody>
      <tr>
        <th>{{ 'Timer' }}</th>
        <td>{{ include('race/timer.html.twig', {timer: extra_data.timer}) }}</td>
      </tr>
      </tbody>
    </table>
    <div class="text-center fw-bold">{{ extra_data.puzzle.grid|raw }}</div>
    {{ include('race/try.html.twig', {tryform: tryform}) }}
  </div>
  <div>
    <table class="table">
      <thead>
      <tr>
        <td>{{ 'Name' }}</td>
      </tr>
      </thead>
      <tbody id="participant-progress">
        {% if (participant is defined) %}
          {% for progressTask in participant.getProgressTaskEntry %}
            <tr>
              <td>
                {% set solutions = participant.getProgressTaskSolution().toArray() %}
                {% set resolved = false %}
                {% set solutionTexts = [] %}
                {% for task in solutions %}
                  {% if progressTask.id == task.id %}
                    {% set resolved = true %}
                    {% set solutionTexts = solutionTexts|merge(task.getSolutions) %}
                  {% endif %}
                {% endfor %}
                {% if resolved is true %}
                  <span>{{ progressTask.title }} Resolved. Solutions: {{ solutionTexts|join(', ') }}</span>
                  -
                  <span>{{ progressTask.getPassKey }}</span>
                {% else %}
                  <span><a href="{{ path('app_task_guess', {id: progressTask.id, uuid: progressTask.uuid, race: race.id}) }}">{{ progressTask.title }}</a></span>
                  -
                  <span>{{ progressTask.getPassKey }}</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        {% endif %}
      </tbody>
    </table>
  </div>
</div>
