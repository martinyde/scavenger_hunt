<turbo-stream action="replace" target="race-{{ race.id }}">
  <template>
    {% set extra_data = global_data(race) %}
    {% if race.isActive and tryform is not null %}
      <div id="race-{{ race.id }}">
        {{ include('race/_race.html.twig', {race: race, tryform: tryform}) }}
      </div>
    {% else %}
      {{ include('race/_race-finished.html.twig', {race: race}) }}
    {% endif %}
  </template>
</turbo-stream>
