<table class="table">
  <thead>
  <tr>
    <th></th>
    <th>{{ 'Participant' }}</th>
    <th>{{ '# Solutions' }}</th>
    <th>{{ '# Entries' }}</th>
    <th>{{ 'Time' }}</th>
  </tr>
  </thead>
  <tbody>
  {% for highscore in highscores %}
    <tr>
      <td>{{ loop.index }}</td>
      <td>{{ highscore.participantName }}</td>
      <td>{{ highscore.progressTaskSolution }}</td>
      <td>{{ highscore.progressTaskEntry }}</td>
      <td>{{ highscore.time }}</td>
    </tr>
  {% else %}
    <tr>
      <td colspan="4">no records found</td>
    </tr>
  {% endfor %}
  </tbody>
</table>