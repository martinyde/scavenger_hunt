<table class="table">
  <thead>
  <tr>
    <th></th>
    <th>{{ 'Participant' }}</th>
    <th>{{ '# Solutions' }}</th>
    <th>{{ '# Entries' }}</th>
    <th>{{ 'Time' }}</th>
  </tr>
  </thead>
  <tbody>
  {% for highscore in highscores %}
    <tr>
      <td>
        {% if loop.index == 1 %}
          <i class="bi bi-trophy-fill color-gold"></i>
        {% elseif loop.index == 2 %}
          <i class="bi bi-trophy-fill color-silver"></i>
        {% elseif loop.index == 3 %}
          <i class="bi bi-trophy-fill color-bronze"></i>
        {% else %}
          {{ loop.index }}
        {% endif %}
      </td>
      <td>{{ highscore.participantName }}</td>
      <td>{{ highscore.progressTaskSolution }}</td>
      <td>{{ highscore.progressTaskEntry }}</td>
      <td>{{ highscore.time }}</td>
    </tr>
  {% else %}
    <tr>
      <td colspan="5">no records found</td>
    </tr>
  {% endfor %}
  </tbody>
</table>