{# Display when race is in progress. #}
<div class="row d-flex flex-column flex-nowrap vh-100">
  {% if (participant is defined) %}
    {% set extra_data = global_data(race) %}
    {% block race_participant_header %}
      <header class="bg-white p-3">
        <h1 class="h3">{{ race.getScavengerHunt.getName }}</h1>
        <div class="row align-items-center">
          <div id="participant-info" class="col">
            <div id="participant-name">
              <h2 class="small">{{ participant.getName }}</h2>
            </div>
            <div id="participant-image">
              <img src="https://placecats.com/80/80" alt="Participant image">
            </div>
          </div>
          <div id="participant-score" class="col">
            <div class="card">
              <ul class="list-group list-group-flush">
                <li class="list-group-item">
                  <i class="bi bi-star-fill color-gold"></i>
                  <span class="m-2">{{ participant.getProgressEntryCount ?? '0' }}/{{ race.getScavengerHunt.getTasks|length }}</span>
                </li>
                <li class="list-group-item">
                  <i class="bi bi-key-fill color-gold"></i>
                  <span class="m-2">{{ participant.getProgressSolutionCount ?? '0' }}/{{ race.getScavengerHunt.getTasks|length }}</span></li>
                <li class="list-group-item">
                  <i class="bi bi-stopwatch-fill"></i>
                  <span class="m-2">{{ include('race/timer.html.twig', {timer: extra_data.timer}) }}</span>
                </li>
              </ul>
            </div>
          </div>
          <div id="race-end" class="col">
            <div id="race-end-action" class="text-center">
              <a class="btn btn-danger" href="{{ path('app_race_participant_finish', {participant: extra_data.participant.id, participantUuid: extra_data.participant.uuid, race: race.id}) }}">{{ 'Finish now'|trans }}</a>
            </div>
          </div>
        </div>
      </header>
    {% endblock %}
    {% block race_participant_main %}
    <main id="participant-main" class="container-fluid flex-grow-1" data-controller="slider">
      <div class="d-flex row h-100">
        <div id="participant-tools">
          <div id="participant-key-finder" class="position-relative">
            <div class="bg-white h-100 pt-5">
              <div  class="container">
                <div>
                  <div class="text-center fw-bold">{{ extra_data.puzzle.grid|raw }}</div>
                  <div class="key-form">
                    {{ include('race/try.html.twig', {tryform: tryform}) }}
                  </div>
                </div>
              </div>
              <div class="btn btn-sm btn-primary p-1 participant-tool-nav position-absolute top-0 end-0">
                <i class="bi bi-arrow-left"></i>
                <i class="bi bi-star"></i>
              </div>
            </div>
          </div>
          <div id="participant-pass-list" class="hide position-relative">
            <div class="bg-white h-100 pt-5">
              <div class="btn btn-sm btn-primary p-1 participant-tool-nav position-absolute top-0 start-0">
                <i class="bi bi-arrow-right"></i>
                <i class="bi bi-key"></i>
              </div>
              <div  class="container overflow-y-auto">
                <div style="">
                  <table class="table">
                    <thead>
                    <tr>
                      <td>{{ 'Name' }}</td>
                    </tr>
                    </thead>
                    <tbody id="participant-progress">
                      {% for progressTask in participant.getProgressTaskEntry %}
                        <tr>
                          <td>
                            {% set solutions = participant.getProgressTaskSolution().toArray() %}
                            {% set resolved = false %}
                            {% set solutionTexts = [] %}
                            {% for task in solutions %}
                              {% if progressTask.id == task.id %}
                                {% set resolved = true %}
                                {% set solutionTexts = solutionTexts|merge(task.getSolutions) %}
                              {% endif %}
                            {% endfor %}
                            {% if resolved is true %}
                              <span>{{ progressTask.title }} Resolved. Solutions: {{ solutionTexts|join(', ') }}</span>
                              -
                              <span>{{ progressTask.getPassKey }}</span>
                            {% else %}
                              <span><a href="{{ path('app_task_guess', {'id': progressTask.id, 'uuid': progressTask.uuid, 'race': race.id}) }}">{{ progressTask.title }}</a></span>
                              -
                              <span>{{ progressTask.getPassKey }}</span>
                            {% endif %}
                          </td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <div class="participant-spacer"></div>
    {% endblock %}
    {% block race_participant_footer %}
      <footer id="participant-footer" class="container-fluid flex-grow-0 border-top border-1 border-dark">
        <div class="row bg-white">
          Lorem ipsum
        </div>
      </footer>
    {% endblock %}
  {% endif %}
</div>