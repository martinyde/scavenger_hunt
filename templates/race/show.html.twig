{% extends 'base-fluid.html.twig' %}

{% block title %}Race{% endblock %}

{% block body %}
  {% set extra_data = global_data(race) %}
  {# Update when the state of a race changes between active/inactive #}
  <div {{ turbo_stream_listen('race_state_changed') }}></div>
  {# Update when a participant progress improves #}
  <div {{ turbo_stream_listen('App\\Entity\\Participant') }}></div>
  <div class="row g-0">
    {# Replaced by RaceParticipant.stream.html.twig #}
    {% block race_header %}
    <div id="race-header-{{ race.id }}">
      {% include 'race/_race-participant-header.html.twig' %}
    </div>
    {% endblock %}
    {% block race_main %}
      {# Replaced by RaceParticipant.stream.form.stream.html.twig #}
      <div id="race-main-{{ race.id }}">
        {% if race.isActive %}
          {% if participant in race.getParticipants.toArray() %}
            {% include 'race/_race-participant-main.html.twig' with {'race': race, 'tryform': tryform, 'participant': participant, 'extra_data': extra_data} %}
          {% else %}
            {{ include('race/_race-access-when-active.html.twig') }}
          {% endif %}
        {% else %}
          {% if not raceHelper.isFinished(race) %}
            {% include 'race/_race-awaiting.html.twig' with {'participant': participant} %}
          {% else %}
            {% include 'race/_race-finished.html.twig' with {'race': race} %}
          {% endif %}
        {% endif %}

        {% if participant not in race.participants and not race.isActive %}
          <a href="{{ path('app_participant_add', {race: race.id, raceUuid: race.uuid}) }}">{{ 'Add new team'|trans }}</a>
        {% endif %}
      </div>
    {% endblock %}
  </div>
{% endblock %}
