{% extends 'base.html.twig' %}

{% block title %}Race{% endblock %}

{% block body %}
    <h1>Race - {{ race.getScavengerHunt.getName }}</h1>
    <div {{ turbo_stream_listen('race_started') }}></div>
    <div {{ turbo_stream_listen('App\\Entity\\Race') }}></div>
    <div id="try-form">
    </div>
    <div>
      <div id="race-{{ race.id }}">
        {% if race.isActive %}
          {% include 'race/_race.html.twig' with {'race': race} %}
          {% include 'race/try.html.twig' with {'tryform': tryform} %}
          <div>
            <table class="table">
              <thead>
              <tr>
                <td>Name</td>
              </tr>
              </thead>
              <tbody id="progress">
              {% for progress in participant.getProgressTaskEntry %}
                <tr>
                  <td>{{ dump(progress) }}</td>
                </tr>
              {% endfor %}
              </tbody>
            </table>
          </div>
        {% else %}
          <div>
            <div class="spinner-border text-primary"></div>
            <div>{{ 'Awaiting contestants' }}</div>
          </div>
          <table class="table" {{ turbo_stream_listen('App\\Entity\\Participant') }}>
            <thead>
            <tr>
              <td>Name</td>
            </tr>
            </thead>
            <tbody class="participants" id="participants">
            {% for participant in race.participants %}
              <tr id="participant-{{ participant.id }}">
                {% include 'race/_participant.html.twig' with {'participant': participant} %}
              </tr>
            {% endfor %}
            </tbody>
          </table>
        {% endif %}
      </div>
    </div>
  {% if participant is empty  %}
    <a href="{{ path('app_participant_join', {'race': race.id, 'raceUuid': race.uuid}) }}">Join</a>
  {% endif %}
{% endblock %}
