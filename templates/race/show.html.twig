{% extends 'base.html.twig' %}

{% block title %}Race{% endblock %}

{% block body %}
    {% set extra_data = global_data(race) %}
    <h1>Race - {{ race.getScavengerHunt.getName }}</h1>
    <div {{ turbo_stream_listen('race_state_changed') }}></div>
    <div {{ turbo_stream_listen('App\\Entity\\Participant') }}></div>
    <div>
      <div id="race-{{ race.id }}">
        {% if race.isActive %}
          {% if participant in race.getParticipants.toArray() %}
            {% include 'race/_race.html.twig' with {'race': race, 'tryform': tryform, 'participant': participant, 'extra_data': extra_data} %}
          {% else %}
            Show denied template
          {% endif %}
        {% else %}
          <div>
            <table class="table">
              <tbody>
              <tr>
                <th>Timer</th>
                <td>{% include 'race/timer.html.twig' with {'timer': extra_data.timer} %}</td>
                <td></td>
              </tr>
              {% if participant in race.getParticipants.toArray() %}
                <tr>
                  <th>Team</th>
                  <td>{{ participant.getName }}</td>
                  <td>
                    {% if participant in race.getParticipants.toArray() %}
                      Join: <a href="{{ path('app_participant_join', {'race': race.id, 'raceUuid': race.uuid, 'participant': participant.id}) }}">
                      {{ path('app_participant_join', {'race': race.id, 'raceUuid': race.uuid, 'participant': participant.id}) }}
                    </a>
                    {% endif %}
                  </td>
                </tr>
              {% endif %}
              </tbody>
            </table>
            <div class="spinner-border text-primary"></div>
            <div>{{ 'Awaiting contestants' }}</div>
          </div>
          <table class="table">
            <thead>
            <tr>
              <td>Name</td>
            </tr>
            </thead>
            <tbody class="participants" id="participants">
            {% for participant in race.participants %}
              <tr id="participant-{{ participant.id }}">
                {% include 'race/_participant.html.twig' with {'participant': participant} %}
              </tr>
            {% endfor %}
            </tbody>
          </table>
        {% endif %}
      </div>
    </div>
  {% if participant is empty and not race.isActive %}
    <a href="{{ path('app_participant_add', {'race': race.id, 'raceUuid': race.uuid}) }}">Add new team</a>
  {% endif %}
{% endblock %}
