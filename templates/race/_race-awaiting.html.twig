{# Display when race is awaiting participants. #}
<div>
  <div class="spinner-border text-primary"></div>
  <div>{{ 'Awaiting contestants' }}</div>
</div>
<table class="table">
  <thead>
  <tr>
    <td>Name</td>
  </tr>
  </thead>
  <tbody class="participants" id="participants">
  {% for participant in race.participants %}
    <tr id="participant-{{ participant.id }}">
      {% include 'participant/_participant.html.twig' with {'participant': participant} %}
    </tr>
  {% endfor %}
  </tbody>
</table>
<a href="{{ path('app_participant_add', {race: race.id, raceUuid: race.uuid}) }}">{{ 'Add new team'|trans }}</a>