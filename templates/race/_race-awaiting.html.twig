{# Display when race is awaiting participants. #}
<div>
  <table class="table">
    <tbody>
    <tr>
      <th>Timer</th>
      <td>{{ include('race/timer.html.twig', {timer: extra_data.timer}) }}</td>
      <td>
        {% if participant in race.getParticipants.toArray() %}

        {% else %}
          <img height="150" src="{{ qr_code_url(absolute_url(app.request.pathinfo)) }}" />
        {% endif %}
      </td>
    </tr>
    {% if participant in race.getParticipants.toArray() %}
      <tr>
        <th>Team</th>
        <td>{{ participant.getName }}</td>
        <td>
          {% if participant in race.getParticipants.toArray() %}
            {{ 'Join team' }}: <a href="{{ path('app_participant_join', {race: race.id, raceUuid: race.uuid, participant: participant.id}) }}">
            {{ path('app_participant_join', {race: race.id, raceUuid: race.uuid, participant: participant.id}) }}
            <img height="150" src="{{ qr_code_url(absolute_url(path('app_participant_join', {race: race.id, raceUuid: race.uuid, participant: participant.id}))) }}" />
          </a>
          {% endif %}
        </td>
      </tr>
    {% endif %}
    </tbody>
  </table>
  <div class="spinner-border text-primary"></div>
  <div>{{ 'Awaiting contestants' }}</div>
</div>
<table class="table">
  <thead>
  <tr>
    <td>Name</td>
  </tr>
  </thead>
  <tbody class="participants" id="participants">
  {% for participant in race.participants %}
    <tr id="participant-{{ participant.id }}">
      {{ include('race/_participant.html.twig', {participant: participant}) }}
    </tr>
  {% endfor %}
  </tbody>
</table>
