{% extends 'base.html.twig' %}

{% block title %}Race{% endblock %}

{% block body %}

  <h1>Race - {{ race.getScavengerHunt.getName }}</h1>
  <table class="table">
    <tbody>
    <tr>
      <th>Timer</th>
      <td>{{ race.getTimeStart ? race.getTimeStart|date("i") : 0 }}/{{ race.raceDuration }}</td>
      <td>{{ form(startRaceForm) }}</td>
    </tr>
    <tr>
      <th>Task_access</th>
      <td></td>
      <td>{{ race.taskAccess ? race.taskAccess|json_encode : '' }}</td>
    </tr>
    </tbody>
  </table>
  <table class="table" {{ turbo_stream_listen('App\\Entity\\Participant') }}>
    <thead>
    <tr>
      <td>Name</td>
    </tr>
    </thead>
    <tbody class="participants" id="participants">
    {% for participant in race.participants %}
      <tr id="participant-{{ participant.id }}">
        {% include 'race/_participant.html.twig' with {'participant': participant} %}
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <a href="{{ path('app_race_index') }}">back to list</a>

  <a href="{{ path('app_race_edit', {'id': race.id}) }}">edit</a>

  {{ include('race/_delete_form.html.twig') }}
{% endblock %}
