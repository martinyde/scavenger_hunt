{% extends 'base-fluid.html.twig' %}

{% block title %}Race{% endblock %}

{% block body %}

  <h1>Race - {{ race.getScavengerHunt.getName }}</h1>
  <table class="table">
    <tbody>
      <tr>
        <th>Timer</th>
        <td>{% include 'race/timer.html.twig' with {'timer': timer} %}</td>
        <td>{{ form(startRaceForm) }}</td>
      </tr>
    </tbody>
  </table>
  <table class="table" {{ turbo_stream_listen('App\\Entity\\Participant') }}>
    <thead>
    <tr>
      <td>Name</td>
      <td>Progress</td>
    </tr>
    </thead>
    <tbody class="participants" id="participants-progress-list">
    {% for participant in race.participants %}
      <tr id="participant-progress-{{ participant.id }}">
        {% include 'race/_participant-progress.html.twig' with {'participant': participant, 'scavengerHunt': race.getScavengerHunt} %}
      </tr>
    {% endfor %}
    </tbody>
  </table>
{% endblock %}
