{# Learn how to use Turbo Streams: https://github.com/symfony/ux-turbo#broadcast-doctrine-entities-update #}
{% block create %}
  <turbo-stream action="append" target="race">
    <template>
    </template>
  </turbo-stream>
{% endblock %}

{% block update %}
  <turbo-stream action="replace" target="race-{{ entity.id }}">
    <template>
    </template>
  </turbo-stream>
{% endblock %}

{% block remove %}
  <turbo-stream action="remove" target="race-{{ id }}">
  </turbo-stream>
{% endblock %}
