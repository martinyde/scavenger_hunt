{# Learn how to use Turbo Streams: https://github.com/symfony/ux-turbo#broadcast-doctrine-entities-update #}
{% block create %}
  <turbo-stream action="append" target="race">
    <template>
    </template>
  </turbo-stream>
{% endblock %}

{% block update %}
  <turbo-stream action="replace" target="race-header-{{ entity.id }}">
    <template>
      {% include 'race/_race-participant-header.html.twig' %}
    </template>
  </turbo-stream>
  <turbo-stream action="replace" target="race-main-{{ entity.id }}">
    <template>
      {% include 'race/_race-participant-main.html.twig' %}
    </template>
  </turbo-stream>
{% endblock %}

{% block remove %}
  <turbo-stream action="remove" target="race-{{ id }}">
  </turbo-stream>
{% endblock %}