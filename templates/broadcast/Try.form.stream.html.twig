<turbo-stream action="replace" target="race-header-{{ race.id }}">
  <template>
    {% set extra_data = global_data(race) %}
    <div id="race-header-{{ race.id }}">
        {{ include('race/_race-participant-header.html.twig', {race: race, participant: extra_data['participant']}) }}
    </div>
  </template>
</turbo-stream>

<turbo-stream action="replace" target="race-main-{{ race.id }}">
  <template>
    {% set extra_data = global_data(race) %}
    {% if race.isActive and tryform is not null %}
      {% if extra_data['participant'] and extra_data['participant'] in race.getParticipants.toArray() %}
        <div id="race-main-{{ race.id }}">
          {{ include('race/_race-participant-main.html.twig', {race: race, tryform: tryform, participant: extra_data['participant']}) }}
        </div>
      {% else %}
        {{ include('race/_race-access-when-active.html.twig') }}
      {% endif %}
    {% else %}
      {% include 'race/_race-finished.html.twig' with {'race': race} %}
    {% endif %}
  </template>
</turbo-stream>
