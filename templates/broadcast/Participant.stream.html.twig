{# Learn how to use Turbo Streams: https://github.com/symfony/ux-turbo#broadcast-doctrine-entities-update #}
{% block create %}
    <turbo-stream action="append" target="participants-progress-list">
      <template>
        <tr id="participant-{{ entity.id }}">
          {% include 'participant/_participant-progress.html.twig' with {'participant': entity} %}
        </tr>
      </template>
    </turbo-stream>
    <turbo-stream action="append" target="participants">
        <template>
          <tr id="participant-{{ entity.id }}">
            {% include 'participant/_participant.html.twig' with {'participant': entity} %}
          </tr>
        </template>
    </turbo-stream>
{% endblock %}

{% block update %}
    <turbo-stream action="update" target="participant-progress-entry-{{ entity.id }}">
      <template>
        {% include 'participant/_participant-progress-entry.html.twig' with {'participant': entity} %}
      </template>
    </turbo-stream>
    <turbo-stream action="update" target="participant-progress-solution-{{ entity.id }}">
      <template>
        {% include 'participant/_participant-progress-solution.html.twig' with {'participant': entity} %}
      </template>
    </turbo-stream>
    <turbo-stream action="update" target="participant-{{ entity.id }}">
        <template>
          {% include 'participant/_participant-progress.html.twig' with {'participant': entity} %}
        </template>
    </turbo-stream>
{% endblock %}

{% block remove %}
    <turbo-stream action="remove" target="participant-{{ id }}">
      <template></template>
    </turbo-stream>
{% endblock %}
