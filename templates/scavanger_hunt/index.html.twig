{% extends 'base.html.twig' %}

{% block title %}ScavangerHunt index{% endblock %}

{% block body %}
    <h1>ScavangerHunt index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for scavanger_hunt in scavanger_hunts %}
            <tr>
                <td>{{ scavanger_hunt.id }}</td>
                <td>{{ scavanger_hunt.name }}</td>
                <td>
                    <a href="{{ path('app_scavanger_hunt_show', {'id': scavanger_hunt.id}) }}">show</a>
                    <a href="{{ path('app_scavanger_hunt_edit', {'id': scavanger_hunt.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="3">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_scavanger_hunt_new') }}">Create new</a>
{% endblock %}
