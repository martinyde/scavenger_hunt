{% extends 'base.html.twig' %}

{% block title %}Task index{% endblock %}

{% block body %}
    <h1>Task index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>PassKey</th>
                <th>Title</th>
                <th>Text_before</th>
                <th>Text_after</th>
                <th>Solutions</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for task in tasks %}
            <tr>
                <td>{{ task.id }}</td>
                <td>{{ task.passKey }}</td>
                <td>{{ task.title }}</td>
                <td>{{ task.textBefore }}</td>
                <td>{{ task.textAfter }}</td>
                <td>
                    <a href="{{ path('app_task_show', {id: task.id, uuid: task.uuid}) }}">show</a>
                    <a href="{{ path('app_task_edit', {id: task.id}) }}">edit</a>
                </td>
                <td>{{ task.solutions|join('|') }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
